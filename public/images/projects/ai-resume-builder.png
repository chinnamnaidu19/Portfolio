<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" width="800" height="450">
  <defs>
    <linearGradient id="aiBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="100%" stop-color="#1e1b4b" />
    </linearGradient>
    <linearGradient id="glowGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#6366f1" />
      <stop offset="100%" stop-color="#a855f7" />
    </linearGradient>
  </defs>
  <rect width="800" height="450" fill="url(#aiBg)"/>
  
  <!-- Subtle decorative circles -->
  <circle cx="200" cy="100" r="140" fill="#4f46e5" fill-opacity="0.15" filter="blur(40px)"/>
  <circle cx="650" cy="350" r="160" fill="#9333ea" fill-opacity="0.15" filter="blur(50px)"/>

  <!-- Main Canvas Container -->
  <rect x="80" y="55" width="640" height="340" rx="16" fill="#1e293b" fill-opacity="0.7" stroke="#475569" stroke-width="1.5"/>
  
  <!-- Header Bar -->
  <rect x="80" y="55" width="640" height="45" rx="16" fill="#0f172a" fill-opacity="0.8"/>
  <circle cx="108" cy="78" r="5" fill="#ef4444" />
  <circle cx="124" cy="78" r="5" fill="#f59e0b" />
  <circle cx="140" cy="78" r="5" fill="#10b981" />
  <text x="165" y="83" fill="#f8fafc" font-family="system-ui, -apple-system, sans-serif" font-size="13" font-weight="600">AI Resume Builder &amp; ATS Optimization Engine</text>

  <!-- Left: Resume Sheet Preview -->
  <g transform="translate(105, 120)">
    <rect width="260" height="250" rx="8" fill="#ffffff" stroke="#cbd5e1" stroke-width="1"/>
    <!-- Simulated resume contents -->
    <rect x="20" y="20" width="120" height="10" rx="3" fill="#1e293b"/>
    <rect x="20" y="36" width="90" height="6" rx="2" fill="#4f46e5"/>
    <line x1="20" y1="52" x2="240" y2="52" stroke="#e2e8f0" stroke-width="1"/>
    
    <!-- Experience Section -->
    <rect x="20" y="62" width="70" height="6" rx="2" fill="#334155"/>
    <rect x="20" y="74" width="220" height="4" rx="2" fill="#94a3b8"/>
    <rect x="20" y="82" width="200" height="4" rx="2" fill="#94a3b8"/>
    <rect x="20" y="90" width="180" height="4" rx="2" fill="#94a3b8"/>

    <!-- Skills Section -->
    <rect x="20" y="106" width="60" height="6" rx="2" fill="#334155"/>
    <rect x="20" y="118" width="40" height="12" rx="4" fill="#e0e7ff"/>
    <rect x="65" y="118" width="45" height="12" rx="4" fill="#e0e7ff"/>
    <rect x="115" y="118" width="40" height="12" rx="4" fill="#e0e7ff"/>
    <rect x="160" y="118" width="50" height="12" rx="4" fill="#e0e7ff"/>

    <!-- Projects Section -->
    <rect x="20" y="142" width="65" height="6" rx="2" fill="#334155"/>
    <rect x="20" y="154" width="215" height="4" rx="2" fill="#94a3b8"/>
    <rect x="20" y="162" width="195" height="4" rx="2" fill="#94a3b8"/>
    <rect x="20" y="170" width="210" height="4" rx="2" fill="#94a3b8"/>

    <rect x="20" y="195" width="220" height="35" rx="6" fill="#f1f5f9" stroke="#cbd5e1" stroke-width="1"/>
    <text x="35" y="216" fill="#059669" font-family="sans-serif" font-size="11" font-weight="700">✓ ATS Compliant Layout</text>
  </g>

  <!-- Right: ATS Score & AI Engine Diagnostics -->
  <g transform="translate(390, 120)">
    <!-- ATS Score Card -->
    <rect width="305" height="110" rx="12" fill="#0f172a" stroke="#4f46e5" stroke-width="1.5"/>
    <text x="20" y="32" fill="#a5b4fc" font-family="sans-serif" font-size="13" font-weight="700">ATS Score &amp; Keyword Match</text>
    
    <text x="20" y="75" fill="#10b981" font-family="sans-serif" font-size="34" font-weight="800">96<tspan font-size="18" fill="#6ee7b7">/100</tspan></text>
    <text x="130" y="60" fill="#f8fafc" font-family="sans-serif" font-size="11" font-weight="600">Keyword Density: High</text>
    <text x="130" y="78" fill="#94a3b8" font-family="sans-serif" font-size="10">Formatting: Single Column Clean</text>
    <text x="130" y="94" fill="#94a3b8" font-family="sans-serif" font-size="10">Action Verbs: Optimized</text>

    <!-- AI Feature Highlights -->
    <rect y="125" width="305" height="125" rx="12" fill="#0f172a" stroke="#9333ea" stroke-width="1"/>
    <text x="20" y="150" fill="#c084fc" font-family="sans-serif" font-size="12" font-weight="700">AI Intelligence Features</text>
    <text x="20" y="172" fill="#e2e8f0" font-family="sans-serif" font-size="11">✦ AI-Generated Executive Summaries</text>
    <text x="20" y="192" fill="#e2e8f0" font-family="sans-serif" font-size="11">✦ NLP-Powered Job Description Match</text>
    <text x="20" y="212" fill="#e2e8f0" font-family="sans-serif" font-size="11">✦ Real-Time Vectorized PDF Export</text>
    <text x="20" y="232" fill="#a78bfa" font-family="monospace" font-size="10">React • TypeScript • Java • Spring Boot</text>
  </g>
</svg>
