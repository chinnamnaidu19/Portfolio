# =============================================================================
# Spring Boot Backend Environment Variables
# =============================================================================

# Server Port
PORT=8080

# Database Configuration (MySQL 8.0)
DB_URL=jdbc:mysql://localhost:3306/portfolio_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_secure_mysql_password_here

# Security / JWT Configuration (256-bit or 512-bit Secret Key)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970337336763979244226452948404D6351655468576D5A7134743777217A25432A
JWT_EXPIRATION_MS=86400000

# CORS Whitelist (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://alexandervance.dev

# GitHub Integration (Optional personal access token for increased rate limits)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Email Notification Service (SMTP)
EMAIL_USERNAME=notifications@alexandervance.dev
EMAIL_PASSWORD=your_app_password_here
